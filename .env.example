# PramanaGST environment template. Copy to .env (never commit .env) and fill in.
# Local dev works with all defaults; production requires the marked secrets.

# dev | prod — prod disables /docs, locks CORS, and requires PRAMANAGST_API_KEY.
PRAMANAGST_ENV=dev

# Override the dataset directory (defaults to backend/ingestion/dataset/generated_data).
# Point at backend/ingestion/dataset/demo_scenarios for the labelled demo dataset.
# PRAMANAGST_DATA_DIR=

# Comma-separated browser origins allowed to call the API.
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# API key for mutating endpoints (POST /api/v1/ingest). REQUIRED in prod.
# PRAMANAGST_API_KEY=

# Set to 1 to serve graph projections from live Neo4j instead of the offline batch.
# PRAMANAGST_USE_NEO4J=
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
# REQUIRED in prod when PRAMANAGST_USE_NEO4J=1. Never commit a real password.
# NEO4J_PASSWORD=

# Optional LLM narrator (OpenAI-compatible). Unset = deterministic template narration.
# PRAMANAGST_LLM_URL=
# OPENAI_API_KEY=

# Logging / server
# PRAMANAGST_LOG_LEVEL=INFO
# HOST=127.0.0.1
# PORT=8000
# WORKERS=1

# Frontend build-time API base. Empty = same origin (used with the nginx /api proxy).
# VITE_API_URL=
